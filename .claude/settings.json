          },
          {
            "type": "command",
            "command": "bash .claude/hooks/posthog-capture.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/posthog-job-research-capture.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/posthog-weekly-coach-capture.sh"
          }
        ]
      }
    ]
