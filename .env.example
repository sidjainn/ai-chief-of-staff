# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
# direnv (.envrc → `dotenv`) auto-loads these into your shell on `cd`.

# ---- PostHog (used by hooks: weekly-coach, job-research, triage capture) ----
# Project API key (write key) — from https://us.posthog.com/project/<id>/settings/project
export POSTHOG_API_KEY=phc_xxx
# Host — keep default unless self-hosted
export POSTHOG_HOST=https://us.posthog.com
# Personal API key — only needed if a script calls the PostHog management API
export POSTHOG_PERSONAL_API_KEY=phx_xxx

# ---- Weekly coach — Google Drive doc IDs ----
# All three docs must be shared "anyone with the link can view".
# IDs are the gibberish in the doc/sheet/folder URL between /d/ and /edit (or /folders/<id>).

# Annual charter — Google Doc
export WEEKLY_COACH_CHARTER_DOC_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Weekly to-do sheet — Google Sheet
export WEEKLY_COACH_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Daily-log folder — Google Drive folder containing monthly daily-log docs
export WEEKLY_COACH_DAILY_LOG_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
